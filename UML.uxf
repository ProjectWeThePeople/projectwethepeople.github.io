<diagram program="umletino" version="15.1"><zoom_level>8</zoom_level><help_text>Belief Circles System - UML Class Diagram

This system enables users to create "truth circles" composed of belief statements called "radians". 
Users can share circles, create connections, and explore their belief systems non-linearly.

Tech Stack: React (Frontend) + Ruby on Rails (Backend API)
Hosting: Live hosting with download capability, updates, and sharing features</help_text>

<!-- Core Domain Models -->
<element><id>UMLClass</id><coordinates><x>100</x><y>100</y><w>220</w><h>200</h></coordinates><panel_attributes>User
--
-id: Long
-username: String
-email: String  
-password_hash: String
-created_at: DateTime
-updated_at: DateTime
-profile_visibility: Enum
--
+create_circle(): Circle
+share_circle(circle_id): void
+connect_to_user(user_id): Connection
+get_circles(): List&lt;Circle&gt;
+update_profile(): void</panel_attributes><additional_attributes></additional_attributes></element>

<element><id>UMLClass</id><coordinates><x>400</x><y>100</y><w>220</w><h>220</h></coordinates><panel_attributes>Circle
--
-id: Long
-user_id: Long
-title: String
-description: String
-is_public: Boolean
-color_theme: String
-created_at: DateTime
-updated_at: DateTime
-version: Integer
--
+add_radian(content): Radian
+remove_radian(radian_id): void
+share_with_user(user_id): Share
+publish(): void
+create_snapshot(): CircleSnapshot
+get_radians(): List&lt;Radian&gt;</panel_attributes><additional_attributes></additional_attributes></element>

<element><id>UMLClass</id><coordinates><x>700</x><y>100</y><w>200</w><h>180</h></coordinates><panel_attributes>Radian
--
-id: Long
-circle_id: Long
-content: Text
-position_angle: Float
-created_at: DateTime
-updated_at: DateTime
-is_archived: Boolean
--
+update_content(text): void
+move_position(angle): void
+archive(): void
+restore(): void</panel_attributes><additional_attributes></additional_attributes></element>

<element><id>UMLClass</id><coordinates><x>100</x><y>400</y><w>200</w><h>160</h></coordinates><panel_attributes>Connection
--
-id: Long
-from_user_id: Long
-to_user_id: Long
-connection_type: Enum
-created_at: DateTime
-status: Enum
--
+accept(): void
+decline(): void
+block(): void</panel_attributes><additional_attributes></additional_attributes></element>

<element><id>UMLClass</id><coordinates><x>400</x><y>400</y><w>200</w><h>160</h></coordinates><panel_attributes>Share
--
-id: Long
-circle_id: Long
-shared_by_user_id: Long
-shared_with_user_id: Long
-permission_level: Enum
-created_at: DateTime
--
+revoke_access(): void
+update_permissions(): void</panel_attributes><additional_attributes></additional_attributes></element>

<element><id>UMLClass</id><coordinates><x>700</x><y>400</y><w>200</w><h>140</h></coordinates><panel_attributes>CircleSnapshot
--
-id: Long
-circle_id: Long
-snapshot_data: JSON
-version: Integer
-created_at: DateTime
--
+restore_version(): Circle</panel_attributes><additional_attributes></additional_attributes></element>

<!-- API Layer -->
