<element><id>UMLClass</id><coordinates><x>500</x><y>650</y><w>180</w><h>120</h></coordinates><panel_attributes>&lt;&lt;Controller&gt;&gt;
RadiansController
--
+create(): Radian
+update(): Radian
+destroy(): void
+reorder(): void</panel_attributes><additional_attributes></additional_attributes></element>

